{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qiming-tool",
  "main": "./worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
