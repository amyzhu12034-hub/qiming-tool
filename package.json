{
  "name": "ming-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Chinese naming tool backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check app.js && wrangler deploy --dry-run",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "corpus:import:shijing": "node scripts/import-shijing.js",
    "corpus:import:classics": "node scripts/import-classics.js"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "wrangler": "^4.59.1"
  }
}
